{
    "name": "ROS Jazzy Dev Container",
    "privileged": true,
    "remoteUser": "${localEnv:USERNAME}",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "USERNAME": "${localEnv:USERNAME}"
        }
    },
    "workspaceFolder": "/home/${localEnv:USERNAME}/ros2_ws",
    "workspaceMount": "source=${localWorkspaceFolder}/src,target=/home/${localEnv:USERNAME}/ros2_ws/src,type=bind",
    "customizations": {
        "vscode": {
            "extensions":[
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "ranch-hand-robotics.rde-pack",
                "ms-python.python"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "python.defaultInterpreterPath": "/usr/bin/python3",
                "python.analysis.extraPaths": [
                    "/opt/ros/jazzy/lib/python3.12/site-packages",
                    "/opt/ros/jazzy/local/lib/python3.12/dist-packages",
                    "${containerWorkspaceFolder}/install/pilz_robot_programming/lib/python3.12/site-packages"
                ],
                "python.autoComplete.extraPaths": [
                    "/opt/ros/jazzy/lib/python3.12/site-packages",
                    "/opt/ros/jazzy/local/lib/python3.12/dist-packages",
                    "${containerWorkspaceFolder}/install/pilz_robot_programming/lib/python3.12/site-packages"
                ]
            }
        }
    },
    "containerEnv": {
        "DISPLAY": "host.docker.internal:0",
        "LIBGL_ALWAYS_SOFTWARE": "1",
        "ROS_DOMAIN_ID": "42",
        "ROS_AUTOMATIC_DISCOVERY_RANGE": "LOCALHOST",
        "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp",
        "ROS_DISTRO": "jazzy"
    },
    "runArgs": [
        "--name=ros2_misr_dev_cnt"
    ],
    "postCreateCommand": "sudo chown -R $(whoami) /home/${localEnv:USERNAME}/ros2_ws/ && ./src/setup_ws.sh"
}
